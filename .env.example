DATABASE_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Resend Email Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
# Fallback "from" address (each form overrides this with its own sender)
RESEND_FROM_EMAIL=onboarding@resend.dev
# The recipient email address for all form submissions
RESEND_TO_EMAIL=starhi@starhiherbs.com
# Per-form senders (configured in email-service.ts):
#   contact@starhiherbs.com    — Contact Form
#   quote@starhiherbs.com      — Request Quote
#   sample@starhiherbs.com     — Request Sample
#   catalogue@starhiherbs.com  — Download Catalogue
#   careers@starhiherbs.com    — Job & General Application
#   meeting@starhiherbs.com    — Request Meeting
# CC on all forms: najish.n@starhiherbs.com

# Cloudflare R2 Storage
# Get these from Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=your-bucket-name
# Public URL for serving files (your R2 custom domain or public bucket URL)
R2_PUBLIC_URL=https://your-r2-public-domain.com
